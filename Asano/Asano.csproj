<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
	<NoWarn>NU1701</NoWarn>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

	<Target Name="WriteBuildPaths" BeforeTargets="BeforeCompile">
		<WriteLinesToFile File="$(IntermediateOutputPath)BuildPaths.g.cs" Lines="namespace Asano;%3B&#xD;&#xA;public static class BuildPaths&#xD;&#xA;{&#xD;&#xA;    public const string SolutionDir = @&quot;$(SolutionDir)&quot;;%3B&#xD;&#xA;    public const string ProjectDir = @&quot;$(ProjectDir)&quot;;%3B&#xD;&#xA;}" Overwrite="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildPaths.g.cs" />
		</ItemGroup>
	</Target>

  <Target Name="RemovePlatformIOVisualStudioNestedGitStub"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\_PlatformIO\.git') and !Exists('$(MSBuildProjectDirectory)\..\_PlatformIO\.git\HEAD') and !Exists('$(MSBuildProjectDirectory)\..\_PlatformIO\.git\config')">
    <ItemGroup>
      <_PlatformIOVisualStudioNestedGitStub Include="$(MSBuildProjectDirectory)\..\_PlatformIO\.git\ms-persist.xml" />
      <_PlatformIOVisualStudioNestedGitStubDirectory Include="$(MSBuildProjectDirectory)\..\_PlatformIO\.git" />
    </ItemGroup>

    <Delete Files="@(_PlatformIOVisualStudioNestedGitStub)" />
    <RemoveDir Directories="@(_PlatformIOVisualStudioNestedGitStubDirectory)" />
  </Target>

  <ItemGroup>
    <Compile Remove="obj\x64\Debug\net8.0-windows10.0.22000.0\BuildPaths.g.cs" />
    <Compile Remove="Resources\_References\ZFixer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Asano.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheLib\TheLib.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="DataTools\Controls\SignalViewer_Csv.cs">
      <DependentUpon>SignalViewer.cs</DependentUpon>
    </Compile>
    <Compile Update="DataTools\Controls\SignalViewer_Draw.cs">
      <DependentUpon>SignalViewer.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Resources\Backgrounds\Desired.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Backgrounds\LabelArea.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Backgrounds\LabelArea.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\Roboto-Medium.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\Roboto-Medium.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\Segoe UI.fnt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\Segoe UI.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\back.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\back.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\msdf.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\msdf.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\_default.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\_default.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\plot.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Shaders\plot.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Controls\HWforState\PSD Master\" />
  </ItemGroup>

  <PropertyGroup>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <ApplicationIcon>Resources\Asano.ico</ApplicationIcon>
  </PropertyGroup>
	
</Project>
